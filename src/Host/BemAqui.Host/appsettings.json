{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Catalog": ""
  },
  "DataProtection": {
    "CertificatePath": "",
    "CertificatePasswordFile": "",
    "AllowKeyRingCreation": false,
    "AutoMigrate": false,
    "GenerateDevelopmentCertificate": false
  },
  "Platform": {
    "Host": "plataforma.bemaquiapp.com.br"
  },
  "Catalog": {
    "AutoMigrate": false
  },
  "Storage": {
    "Root": "/data/files"
  },
  "ClamAV": {
    "Host": "clamav",
    "Port": 3310
  },
  "ReverseProxy": {
    "KnownNetworks": [],
    "RequireTrustedProxy": false
  },
  "RateLimit": {
    "Auth": {
      "PerIpPerMinute": 20,
      "PerTenantPerMinute": 300
    }
  },
  "Auth": {
    "Issuer": "bemaqui-empresas",
    "SigningKey": ""
  },
  "Email": {
    "FromAddress": "nao-responda@bemaquiapp.com.br",
    "FromName": "BemAqui Empresas",
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUsername": "",
    "SmtpPassword": "",
    "Security": "StartTls"
  },
  "Health": {
    "ClamAv": true,
    "Storage": true,
    "Hangfire": true
  },
  "Alerts": {
    "Recipients": [],
    "DedupWindow": "00:30:00",
    "IntegrationFailureThreshold": 5,
    "PlatformBaseUrl": "https://plataforma.bemaquiapp.com.br"
  },
  "Logging": {
    "File": {
      "Path": "",
      "FileSizeLimitBytes": 104857600,
      "RetainedDays": 30
    }
  }
}
