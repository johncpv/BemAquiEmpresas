{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Catalog": ""
  },
  "DataProtection": {
    "CertificatePath": "",
    "CertificatePasswordFile": "",
    "AllowKeyRingCreation": false,
    "AutoMigrate": false,
    "GenerateDevelopmentCertificate": false
  },
  "Platform": {
    "Host": "plataforma.bemaquiapp.com.br"
  },
  "Catalog": {
    "AutoMigrate": false
  },
  "Storage": {
    "Root": "/data/files"
  },
  "ClamAV": {
    "Host": "clamav",
    "Port": 3310
  },
  "ReverseProxy": {
    "KnownNetworks": [],
    "RequireTrustedProxy": false
  },
  "Auth": {
    "Issuer": "bemaqui-empresas",
    "SigningKey": ""
  }
}
