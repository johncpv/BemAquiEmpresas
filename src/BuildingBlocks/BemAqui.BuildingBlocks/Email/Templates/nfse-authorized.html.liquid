<!doctype html>
<html lang="pt-BR">
<body style="margin:0;padding:24px;background:#e9edf1;font-family:Arial,sans-serif;color:#14202b">
  <table role="presentation" width="100%" style="max-width:560px;margin:0 auto;background:#ffffff;border-radius:10px">
    <tr><td style="padding:24px">
      <h1 style="font-size:20px;margin:0 0 16px">Nota fiscal de serviço {{ number }}</h1>
      <p>{{ tenant_name }} emitiu a NFS-e número {{ number }}, de {{ issued_on }}, no valor de {{ amount }}.</p>
      <p style="font-size:13px;color:#5a6774">Código de verificação</p>
      <p style="font-family:monospace;font-size:15px;word-break:break-all">{{ verification_code }}</p>
      <p style="font-size:13px;color:#5a6774">A nota da prefeitura está anexa a este e-mail. Guarde o arquivo: ele é o documento fiscal.</p>
    </td></tr>
  </table>
</body>
</html>
