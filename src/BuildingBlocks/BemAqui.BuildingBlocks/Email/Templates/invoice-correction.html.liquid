<!doctype html>
<html lang="pt-BR">
<body style="margin:0;padding:24px;background:#e9edf1;font-family:Arial,sans-serif;color:#14202b">
  <table role="presentation" width="100%" style="max-width:560px;margin:0 auto;background:#ffffff;border-radius:10px">
    <tr><td style="padding:24px">
      <h1 style="font-size:20px;margin:0 0 16px">Carta de correção da NF-e {{ invoice_number }}</h1>
      <p>{{ tenant_name }} registrou na SEFAZ a carta de correção número {{ sequence }} da NF-e número {{ number }}, série {{ series }}.</p>
      <p style="font-size:13px;color:#5a6774">Chave de acesso</p>
      <p style="font-family:monospace;font-size:15px;word-break:break-all">{{ access_key }}</p>
      <p style="font-size:13px;color:#5a6774">Protocolo: {{ protocol }}</p>
      <p><b>Correção:</b> {{ text }}</p>
      {% if has_xml %}<p style="font-size:13px;color:#5a6774">O XML do evento está anexo a este e-mail. Guarde-o com a nota.</p>{% endif %}
    </td></tr>
  </table>
</body>
</html>
