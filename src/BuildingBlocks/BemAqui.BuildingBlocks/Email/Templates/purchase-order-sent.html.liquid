<!doctype html>
<html lang="pt-BR">
<body style="margin:0;padding:24px;background:#e9edf1;font-family:Arial,sans-serif;color:#14202b">
  <table role="presentation" width="100%" style="max-width:560px;margin:0 auto;background:#ffffff;border-radius:10px">
    <tr><td style="padding:24px">
      <h1 style="font-size:20px;margin:0 0 16px">Pedido de compra {{ order_number }}</h1>
      <p>{{ tenant_name }} enviou o pedido de compra {{ order_number }}, com previsão de entrega em {{ expected_date }}.</p>
      {% if message != blank %}<p style="white-space:pre-line">{{ message }}</p>{% endif %}
      <p style="font-size:13px;color:#5a6774">O pedido está em PDF, anexo a este e-mail, com os itens, as quantidades, os preços e a condição de pagamento.</p>
      <p style="font-size:13px;color:#5a6774">Para responder, use o próprio e-mail: a resposta vai para {{ sender_name }}.</p>
    </td></tr>
  </table>
</body>
</html>
