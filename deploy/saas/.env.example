# Ambiente SaaS (ADR 0051). Copie para /opt/projetos/bemaqui-saas/.env (chown root:root, chmod 0600) e preencha.
# Só nomes aqui: nenhum valor, nenhum segredo. O compose usa ${VAR:?} e recusa subir com variável obrigatória vazia.
# Os segredos ficam em /opt/projetos/bemaqui-saas/secrets/ (lista no fim), nunca neste arquivo nem em variável de ambiente.

# Versão das imagens: o SHA completo (40 caracteres) do commit publicado. O deploy troca sozinho a cada deploy.
IMAGE_TAG=
# Prefixo das imagens do SaaS. Pelo scripts/deploy-saas.sh as imagens chegam por "docker save | docker load" (sem GHCR) com este mesmo
# prefixo; use um caminho próprio (ex.: ghcr.io/<dono>/saas) para a tag <sha> nunca colidir com a da stack da Konebras.
REGISTRY=
# Host da plataforma (super admin, Hangfire, /webhooks/). PLACEHOLDER: domínio ainda não definido pelo PO (ADR 0051 §6).
PLATFORM_HOST=
# Host do ERP do tenant "bemaqui" (o host em si fica em catalog.tenant_domains), usado na fumaça do deploy. PLACEHOLDER (ADR 0051 §6).
# Deixe VAZIO até o tenant bemaqui ser provisionado: sem host, a fumaça local é pulada.
TENANT_HOST=
# E-mail que recebe os alertas (super admin).
ALERT_RECIPIENT=
# SMTP de envio (a senha vai em secrets/smtp-password).
SMTP_HOST=
SMTP_USERNAME=
# Só na primeira subida do ambiente novo (cria o key ring); deixe vazio ou false depois.
ALLOW_KEY_RING_CREATION=
# Só quando o backup externo for ligado (antes do primeiro cliente com dado real). Provedor S3 do rclone (padrão Other).
S3_PROVIDER=

# --- Arquivos esperados em secrets/ (diretório 0700, root; cada arquivo chmod 0400, dono = uid do container que lê) ---
# Como gerar cada um: docs/operacao/segredos-e-chaves.md e docs/operacao/deploy.md ("Ambiente SaaS"). Todos NOVOS: nenhum vem da Konebras.
#   dono 70 (postgres):
#     pg-superuser-password          senha do superuser postgres
#     pg-catalog-password            senha do role bemaqui_catalog
#     pg-provisioner-password        senha do role bemaqui_provisioner
#   dono 1654 (api e migrator):
#     catalog-connection             Host=bqe-saas-postgres;Database=catalog;Username=bemaqui_catalog;Password=<pg-catalog-password>
#     provisioner-connection         Host=bqe-saas-postgres;Database=postgres;Username=bemaqui_provisioner;Password=<pg-provisioner-password>
#     auth-signing-key               chave de assinatura do JWT
#     smtp-password                  senha do SMTP
#     dp-cert.pfx                    certificado do key ring (RSA 3072+, novo, só do SaaS)
#     dp-cert-password               senha do dp-cert.pfx
#   dono 10001 (backup; SÓ quando o backup externo for ligado, antes do primeiro cliente com dado real):
#     backup-pg-password             a mesma senha do pg-superuser-password
#     backup-age-recipients          chave pública age1... do SaaS do PO (a privada fica só no cofre)
#     dumps-s3-endpoint, dumps-s3-bucket, dumps-s3-access-key, dumps-s3-secret-key         bucket dos dumps (chave sem deleteFiles)
#     keyring-s3-endpoint, keyring-s3-bucket, keyring-s3-access-key, keyring-s3-secret-key  bucket da trilha do key ring (outra chave)
# Fora de secrets/:
#   .docker/config.json (0600)       login do GHCR só leitura do SaaS (DOCKER_CONFIG do deploy.sh), só se o deploy for por pull
