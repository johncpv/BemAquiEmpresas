# Produção (GOL-01a, ADR 0034). Copie para /opt/projetos/bemaqui-empresas/.env (chown root:root, chmod 0600) e preencha.
# Só nomes aqui: nenhum valor, nenhum segredo. O compose usa ${VAR:?} e recusa subir com variável obrigatória vazia.
# Os segredos ficam em /opt/projetos/bemaqui-empresas/secrets/ (lista no fim), nunca neste arquivo nem em variável de ambiente.

# Versão das imagens: o SHA completo (40 caracteres) do commit publicado. O deploy.sh troca sozinho a cada deploy.
IMAGE_TAG=
# Registry das imagens de PRODUÇÃO. Caminho próprio (ex.: ghcr.io/<dono>/prod), para a tag <sha> nunca colidir com a imagem de
# homologação do mesmo commit, nem no GHCR nem no Docker da VPS (a web da homologação pode ter a galeria de moldes ligada).
REGISTRY=
# Host da plataforma de produção (super admin, Hangfire, webhooks), ADR 0005 D2. Ex.: plataforma.<domínio da plataforma>.
PLATFORM_HOST=
# Host do tenant konebras para a fumaça do deploy.sh (o host em si fica em catalog.tenant_domains). Ex.: app.<domínio do cliente>.
# Deixe VAZIO até a virada (GOL-01b): antes dela o app.<domínio> ainda é o Dolibarr, e a fumaça faria o deploy voltar. No ensaio, o
# host de ensaio do runbook.
TENANT_HOST=
# E-mail que recebe os alertas (super admin).
ALERT_RECIPIENT=
# SMTP de envio (a senha vai em secrets/smtp-password).
SMTP_HOST=
SMTP_USERNAME=
# Provedor S3 do rclone para o B2 (ex.: Other ou B2-compatível; padrão Other).
S3_PROVIDER=
# Só na primeira subida do ambiente novo (cria o key ring); deixe vazio ou false depois.
ALLOW_KEY_RING_CREATION=

# --- Arquivos esperados em secrets/ (diretório 0700, root; cada arquivo chmod 0400, dono = uid do container que lê) ---
# Como gerar cada um: docs/operacao/segredos-e-chaves.md, seção "Produção". Todos NOVOS: nenhum vem da homologação.
#   dono 70 (postgres):
#     pg-superuser-password          senha do superuser postgres
#     pg-catalog-password            senha do role bemaqui_catalog
#     pg-provisioner-password        senha do role bemaqui_provisioner
#   dono 1654 (api e migrator):
#     catalog-connection             Host=bqe-prod-postgres;Database=catalog;Username=bemaqui_catalog;Password=<pg-catalog-password>
#     provisioner-connection         Host=bqe-prod-postgres;Database=postgres;Username=bemaqui_provisioner;Password=<pg-provisioner-password>
#     auth-signing-key               chave de assinatura do JWT
#     smtp-password                  senha do SMTP
#     dp-cert.pfx                    certificado do key ring (RSA 3072+, novo, só da produção)
#     dp-cert-password               senha do dp-cert.pfx
#   dono 10001 (backup):
#     backup-pg-password             a mesma senha do pg-superuser-password
#     backup-age-recipients          chave pública age1... de produção do PO (a privada fica só no cofre)
#     dumps-s3-endpoint              endpoint S3 do B2 (bucket dos dumps de produção)
#     dumps-s3-bucket                nome do bucket dos dumps de produção
#     dumps-s3-access-key            keyID da chave de aplicação do bucket dos dumps (sem deleteFiles)
#     dumps-s3-secret-key            applicationKey da mesma chave
#     keyring-s3-endpoint            endpoint S3 do B2 (bucket da trilha do key ring)
#     keyring-s3-bucket              nome do bucket da trilha do key ring de produção
#     keyring-s3-access-key          keyID da outra chave de aplicação (sem deleteFiles)
#     keyring-s3-secret-key          applicationKey da mesma chave
# Fora de secrets/:
#   .docker/config.json (0600)       login do GHCR só leitura da produção (DOCKER_CONFIG do deploy.sh), separado do da homologação
