# Copie para /opt/projetos/bemaqui-empresas-homolog/.env (chmod 600). Sem segredos aqui: eles ficam em ./secrets/.
# Versão das imagens: o deploy.sh troca para o SHA do commit publicado.
IMAGE_TAG=homolog
REGISTRY=ghcr.io/johncpv
# Hosts (ADR 0015): DNS-only no Cloudflare, apontando para 2.25.82.127.
TENANT_HOST=homolog.konebras.com.br
PLATFORM_HOST=plataforma-homolog.bemaquiapp.com.br
# Destinatários dos alertas (super admins).
ALERT_RECIPIENT=alertas@exemplo.com.br
SMTP_HOST=smtp.example.com
SMTP_USERNAME=
