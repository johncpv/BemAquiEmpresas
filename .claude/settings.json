{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Write(/src/**)",
      "Write(/tests/**)",
      "Write(/docs/**)",
      "Write(/deploy/**)",
      "Write(/.github/**)",
      "Write(/*)",
      "Edit(/src/**)",
      "Edit(/tests/**)",
      "Edit(/docs/**)",
      "Edit(/deploy/**)",
      "Edit(/.github/**)",
      "Edit(/*)",
      "Bash(dotnet *)",
      "Bash(pnpm *)",
      "Bash(git *)",
      "Bash(docker *)",
      "Bash(docker compose *)",
      "PowerShell(dotnet *)",
      "PowerShell(pnpm *)",
      "PowerShell(git *)",
      "PowerShell(docker *)"
    ]
  }
}
